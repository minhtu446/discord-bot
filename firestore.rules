rules_version = '2';

// Firestore của bot Clowo.
// Chặn TOÀN BỘ truy cập từ client (web/app dùng Firebase SDK).
// Bot và Cloudflare Worker dùng service account (IAM) nên vẫn đọc/ghi bình thường.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
